<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up everything except the encrypted AI API keys (AiApi), whose Keystore key never leaves the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai_keys.xml" />
    </device-transfer>
</data-extraction-rules>
