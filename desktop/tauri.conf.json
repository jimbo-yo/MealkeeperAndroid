{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt to Pan",
  "version": "1.1.0",
  "identifier": "com.jimboyo.prompttopan",
  "build": {
    "frontendDist": "../app/src/main/assets"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Prompt to Pan",
    "shortDescription": "Plan meals with AI, then cook from recipes, shopping lists and timelines.",
    "category": "Utility",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
